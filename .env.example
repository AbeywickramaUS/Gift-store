# ============================================
# Gift Store - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Supabase Configuration (Free Tier)
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (for admin/server-side operations only)
# WARNING: Never expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Protects /api/keep-alive (Vercel Cron sends it as a Bearer token).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=your-random-cron-secret

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social Media Links (for DM order flow)
NEXT_PUBLIC_INSTAGRAM_USERNAME=your_instagram_handle
NEXT_PUBLIC_FACEBOOK_PAGE_ID=your_facebook_page_id

# ---- Orders via WhatsApp ----
# Business WhatsApp number that receives orders, international format, digits only (94 = Sri Lanka)
NEXT_PUBLIC_WHATSAPP_NUMBER=94770000000

# Bank account customers transfer to (server-only — shown after an order is placed)
BANK_NAME=YOUR BANK NAME
BANK_BRANCH=YOUR BRANCH
BANK_ACCOUNT_NAME=YOUR ACCOUNT NAME
BANK_ACCOUNT_NUMBER=0000000000
